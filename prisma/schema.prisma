// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== GYM/TENANT ====================

model Gym {
  id            String   @id @default(cuid())
  name          String   // e.g., "FitGym"
  slug          String   @unique // e.g., "fitgym" — used for subdomain
  customDomain  String?  @unique // e.g., "fitgym.ng"
  logo          String?
  favicon       String?
  primaryColor  String   @default("#6366F1")
  secondaryColor String  @default("#818CF8")
  description   String?  @db.Text
  tagline       String?  // Short tagline for hero section
  address       String?
  city          String?
  state         String?
  country       String   @default("Nigeria")
  phone         String?
  email         String?
  website       String?

  // Social Media
  facebook      String?
  instagram     String?
  twitter       String?
  youtube       String?
  tiktok        String?

  // Business Hours (JSON for flexibility)
  businessHours Json?    // { monday: { open: "06:00", close: "22:00" }, ... }

  // SEO & Metadata
  metaTitle       String?
  metaDescription String?
  metaKeywords    String[]

  // Landing Page Content (JSON for flexibility)
  heroContent     Json?    // { title, subtitle, ctaText, ctaLink, backgroundImage }
  features        Json?    // Array of feature objects
  aboutContent    Json?    // { title, description, image, stats }

  // Settings
  settings      Json?    // Flexible settings object
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations - All tenant-specific data
  users           User[]
  membershipPlans MembershipPlan[]
  memberships     Membership[]
  gymClasses      GymClass[]
  classSchedules  ClassSchedule[]
  classBookings   ClassBooking[]
  trainers        Trainer[]
  trainingSessions TrainingSession[]
  payments        Payment[]
  notifications   Notification[]
  contactInquiries ContactInquiry[]
  testimonials    Testimonial[]
  announcements   Announcement[]
  equipment       Equipment[]

  @@map("gyms")
}

// ==================== USER & AUTH ====================

model User {
  id            String    @id @default(cuid())
  gymId         String
  email         String
  emailVerified DateTime?
  passwordHash  String?
  firstName     String
  lastName      String
  phone         String?
  avatar        String?
  role          UserRole  @default(MEMBER)
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  gym              Gym               @relation(fields: [gymId], references: [id], onDelete: Cascade)
  membership       Membership?
  bookings         ClassBooking[]
  payments         Payment[]
  trainingSessions TrainingSession[]
  accounts         Account[]
  authSessions     Session[]
  notifications    Notification[]

  @@unique([gymId, email]) // Email unique per gym
  @@index([gymId])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

enum UserRole {
  MEMBER
  TRAINER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

// ==================== MEMBERSHIP ====================

model MembershipPlan {
  id          String   @id @default(cuid())
  gymId       String
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  currency    String   @default("NGN")
  duration    Int      // in days
  features    String[] // Array of feature strings
  isActive    Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  gym         Gym          @relation(fields: [gymId], references: [id], onDelete: Cascade)
  memberships Membership[]

  @@unique([gymId, name]) // Plan name unique per gym
  @@index([gymId])
  @@map("membership_plans")
}

model Membership {
  id        String           @id @default(cuid())
  gymId     String
  userId    String           @unique
  planId    String
  status    MembershipStatus @default(ACTIVE)
  startDate DateTime
  endDate   DateTime
  autoRenew Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  // Relations
  gym      Gym            @relation(fields: [gymId], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan     MembershipPlan @relation(fields: [planId], references: [id])
  payments Payment[]

  @@index([gymId])
  @@map("memberships")
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PAUSED
}

// ==================== CLASSES & SCHEDULING ====================

model GymClass {
  id          String        @id @default(cuid())
  gymId       String
  name        String
  description String?
  duration    Int           // in minutes
  capacity    Int
  category    ClassCategory
  imageUrl    String?
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Relations
  gym       Gym             @relation(fields: [gymId], references: [id], onDelete: Cascade)
  schedules ClassSchedule[]

  @@unique([gymId, name]) // Class name unique per gym
  @@index([gymId])
  @@map("gym_classes")
}

model ClassSchedule {
  id          String    @id @default(cuid())
  gymId       String
  classId     String
  trainerId   String
  dayOfWeek   DayOfWeek
  startTime   String    // HH:mm format
  endTime     String    // HH:mm format
  maxCapacity Int
  location    String?   // e.g., "Studio A", "Main Floor"
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  gym      Gym            @relation(fields: [gymId], references: [id], onDelete: Cascade)
  gymClass GymClass       @relation(fields: [classId], references: [id], onDelete: Cascade)
  trainer  Trainer        @relation(fields: [trainerId], references: [id])
  bookings ClassBooking[]

  @@index([gymId])
  @@map("class_schedules")
}

model ClassBooking {
  id         String        @id @default(cuid())
  gymId      String
  userId     String
  scheduleId String
  date       DateTime      // Specific date of the booking
  status     BookingStatus @default(CONFIRMED)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  // Relations
  gym      Gym           @relation(fields: [gymId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedule ClassSchedule @relation(fields: [scheduleId], references: [id])

  @@unique([userId, scheduleId, date])
  @@index([gymId])
  @@map("class_bookings")
}

enum ClassCategory {
  HIIT
  YOGA
  STRENGTH
  CARDIO
  SPIN
  CROSSFIT
  PILATES
  BOXING
  DANCE
  OTHER
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

// ==================== TRAINERS ====================

model Trainer {
  id          String   @id @default(cuid())
  gymId       String
  firstName   String
  lastName    String
  email       String
  phone       String?
  bio         String?  @db.Text
  specialties String[]
  imageUrl    String?
  certifications String[]
  yearsExperience Int?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  gym       Gym               @relation(fields: [gymId], references: [id], onDelete: Cascade)
  schedules ClassSchedule[]
  sessions  TrainingSession[]

  @@unique([gymId, email]) // Email unique per gym
  @@index([gymId])
  @@map("trainers")
}

model TrainingSession {
  id        String        @id @default(cuid())
  gymId     String
  userId    String
  trainerId String
  date      DateTime
  duration  Int           // in minutes
  notes     String?       @db.Text
  status    SessionStatus @default(SCHEDULED)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  // Relations
  gym     Gym     @relation(fields: [gymId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  trainer Trainer @relation(fields: [trainerId], references: [id])

  @@index([gymId])
  @@map("training_sessions")
}

enum SessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

// ==================== PAYMENTS ====================

model Payment {
  id              String        @id @default(cuid())
  gymId           String
  userId          String
  membershipId    String?
  amount          Decimal       @db.Decimal(10, 2)
  currency        String        @default("NGN")
  status          PaymentStatus @default(PENDING)
  paymentMethod   String?
  paymentProvider String?       // e.g., "paystack", "flutterwave", "stripe"
  providerRef     String?       @unique // Provider's reference ID
  description     String?
  metadata        Json?         // Additional payment data
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  gym        Gym         @relation(fields: [gymId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership Membership? @relation(fields: [membershipId], references: [id])

  @@index([gymId])
  @@map("payments")
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// ==================== NOTIFICATIONS ====================

model Notification {
  id        String           @id @default(cuid())
  gymId     String
  userId    String
  title     String
  message   String
  type      NotificationType
  isRead    Boolean          @default(false)
  link      String?          // Optional link to navigate to
  createdAt DateTime         @default(now())

  // Relations
  gym  Gym  @relation(fields: [gymId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@map("notifications")
}

enum NotificationType {
  MEMBERSHIP
  BOOKING
  PAYMENT
  GENERAL
  PROMO
}

// ==================== CONTACT & INQUIRIES ====================

model ContactInquiry {
  id        String        @id @default(cuid())
  gymId     String
  name      String
  email     String
  phone     String?
  interest  String?
  message   String        @db.Text
  status    InquiryStatus @default(NEW)
  notes     String?       @db.Text // Internal notes
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  // Relations
  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@map("contact_inquiries")
}

enum InquiryStatus {
  NEW
  CONTACTED
  RESOLVED
  CLOSED
}

// ==================== TESTIMONIALS ====================

model Testimonial {
  id        String   @id @default(cuid())
  gymId     String
  name      String
  role      String?  // e.g., "Premium Member", "VIP Member"
  content   String   @db.Text
  rating    Int?     @default(5) // 1-5 stars
  imageUrl  String?
  isActive  Boolean  @default(true)
  isFeatured Boolean @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@map("testimonials")
}

// ==================== ANNOUNCEMENTS ====================

model Announcement {
  id          String   @id @default(cuid())
  gymId       String
  title       String
  content     String   @db.Text
  type        AnnouncementType @default(INFO)
  isActive    Boolean  @default(true)
  isPinned    Boolean  @default(false)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@map("announcements")
}

enum AnnouncementType {
  INFO
  WARNING
  PROMO
  EVENT
  MAINTENANCE
}

// ==================== EQUIPMENT ====================

model Equipment {
  id          String   @id @default(cuid())
  gymId       String
  name        String
  category    String   // e.g., "Cardio", "Strength", "Free Weights"
  brand       String?
  model       String?
  quantity    Int      @default(1)
  location    String?  // e.g., "Main Floor", "Studio A"
  status      EquipmentStatus @default(AVAILABLE)
  purchaseDate DateTime?
  lastMaintenance DateTime?
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@map("equipment")
}

enum EquipmentStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  OUT_OF_ORDER
  RETIRED
}
