generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Gym {
  id               String            @id @default(cuid())
  name             String
  slug             String            @unique
  customDomain     String?           @unique
  logo             String?
  favicon          String?
  primaryColor     String            @default("#6366F1")
  secondaryColor   String            @default("#818CF8")
  description      String?
  tagline          String?
  address          String?
  city             String?
  state            String?
  country          String            @default("Nigeria")
  phone            String?
  email            String?
  website          String?
  facebook         String?
  instagram        String?
  twitter          String?
  youtube          String?
  tiktok           String?
  businessHours    Json?
  metaTitle        String?
  metaDescription  String?
  metaKeywords     String[]
  heroContent      Json?
  features         Json?
  aboutContent     Json?
  settings         Json?
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  announcements    Announcement[]
  classBookings    ClassBooking[]
  classSchedules   ClassSchedule[]
  contactInquiries ContactInquiry[]
  equipment        Equipment[]
  gymClasses       GymClass[]
  membershipPlans  MembershipPlan[]
  memberships      Membership[]
  notifications    Notification[]
  payments         Payment[]
  testimonials     Testimonial[]
  trainers         Trainer[]
  trainingSessions TrainingSession[]
  users            User[]

  @@map("gyms")
}

model User {
  id               String            @id @default(cuid())
  gymId            String
  email            String
  emailVerified    DateTime?
  passwordHash     String?
  firstName        String
  lastName         String
  phone            String?
  avatar           String?
  role             UserRole          @default(MEMBER)
  status           UserStatus        @default(ACTIVE)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  accounts         Account[]
  bookings         ClassBooking[]
  membership       Membership?
  notifications    Notification[]
  payments         Payment[]
  authSessions     Session[]
  trainingSessions TrainingSession[]
  gym              Gym               @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@unique([gymId, email])
  @@index([gymId])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model MembershipPlan {
  id            String       @id @default(cuid())
  gymId         String
  name          String
  description   String?
  price         Decimal      @db.Decimal(10, 2)
  currency      String       @default("NGN")
  billingCycle  BillingCycle @default(MONTHLY)
  durationValue Int
  durationType  DurationType @default(MONTHS)
  classCredits  Int?
  features      String[]
  isActive      Boolean      @default(true)
  isFeatured    Boolean      @default(false)
  sortOrder     Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  gym           Gym          @relation(fields: [gymId], references: [id], onDelete: Cascade)
  memberships   Membership[]

  @@unique([gymId, name])
  @@index([gymId])
  @@map("membership_plans")
}

model Membership {
  id        String           @id @default(cuid())
  gymId     String
  userId    String           @unique
  planId    String
  status    MembershipStatus @default(ACTIVE)
  startDate DateTime
  endDate   DateTime
  autoRenew Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  gym       Gym              @relation(fields: [gymId], references: [id], onDelete: Cascade)
  plan      MembershipPlan   @relation(fields: [planId], references: [id])
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments  Payment[]

  @@index([gymId])
  @@map("memberships")
}

model GymClass {
  id          String          @id @default(cuid())
  gymId       String
  name        String
  description String?
  duration    Int
  capacity    Int
  category    ClassCategory
  imageUrl    String?
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  schedules   ClassSchedule[]
  gym         Gym             @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@unique([gymId, name])
  @@index([gymId])
  @@map("gym_classes")
}

model ClassSchedule {
  id          String         @id @default(cuid())
  gymId       String
  classId     String
  trainerId   String
  dayOfWeek   DayOfWeek
  startTime   String
  endTime     String
  maxCapacity Int
  location    String?
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  bookings    ClassBooking[]
  gymClass    GymClass       @relation(fields: [classId], references: [id], onDelete: Cascade)
  gym         Gym            @relation(fields: [gymId], references: [id], onDelete: Cascade)
  trainer     Trainer        @relation(fields: [trainerId], references: [id])

  @@index([gymId])
  @@map("class_schedules")
}

model ClassBooking {
  id         String        @id @default(cuid())
  gymId      String
  userId     String
  scheduleId String
  date       DateTime
  status     BookingStatus @default(CONFIRMED)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  gym        Gym           @relation(fields: [gymId], references: [id], onDelete: Cascade)
  schedule   ClassSchedule @relation(fields: [scheduleId], references: [id])
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scheduleId, date])
  @@index([gymId])
  @@map("class_bookings")
}

model Trainer {
  id              String            @id @default(cuid())
  gymId           String
  firstName       String
  lastName        String
  email           String
  phone           String?
  bio             String?
  specialties     String[]
  imageUrl        String?
  certifications  String[]
  yearsExperience Int?
  isActive        Boolean           @default(true)
  sortOrder       Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  schedules       ClassSchedule[]
  gym             Gym               @relation(fields: [gymId], references: [id], onDelete: Cascade)
  sessions        TrainingSession[]

  @@unique([gymId, email])
  @@index([gymId])
  @@map("trainers")
}

model TrainingSession {
  id        String        @id @default(cuid())
  gymId     String
  userId    String
  trainerId String
  date      DateTime
  duration  Int
  notes     String?
  status    SessionStatus @default(SCHEDULED)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  gym       Gym           @relation(fields: [gymId], references: [id], onDelete: Cascade)
  trainer   Trainer       @relation(fields: [trainerId], references: [id])
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@map("training_sessions")
}

model Payment {
  id              String        @id @default(cuid())
  gymId           String
  userId          String
  membershipId    String?
  amount          Decimal       @db.Decimal(10, 2)
  currency        String        @default("NGN")
  status          PaymentStatus @default(PENDING)
  paymentMethod   String?
  paymentProvider String?
  providerRef     String?       @unique
  description     String?
  metadata        Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  gym             Gym           @relation(fields: [gymId], references: [id], onDelete: Cascade)
  membership      Membership?   @relation(fields: [membershipId], references: [id])
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@map("payments")
}

model Notification {
  id        String           @id @default(cuid())
  gymId     String
  userId    String
  title     String
  message   String
  type      NotificationType
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())
  gym       Gym              @relation(fields: [gymId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@map("notifications")
}

model ContactInquiry {
  id        String        @id @default(cuid())
  gymId     String
  name      String
  email     String
  phone     String?
  interest  String?
  message   String
  status    InquiryStatus @default(NEW)
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  gym       Gym           @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@map("contact_inquiries")
}

model Testimonial {
  id         String   @id @default(cuid())
  gymId      String
  name       String
  role       String?
  content    String
  rating     Int?     @default(5)
  imageUrl   String?
  isActive   Boolean  @default(true)
  isFeatured Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  gym        Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@map("testimonials")
}

model Announcement {
  id        String           @id @default(cuid())
  gymId     String
  title     String
  content   String
  type      AnnouncementType @default(INFO)
  isActive  Boolean          @default(true)
  isPinned  Boolean          @default(false)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  gym       Gym              @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@map("announcements")
}

model Equipment {
  id              String          @id @default(cuid())
  gymId           String
  name            String
  category        String
  brand           String?
  model           String?
  quantity        Int             @default(1)
  location        String?
  status          EquipmentStatus @default(AVAILABLE)
  purchaseDate    DateTime?
  lastMaintenance DateTime?
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  gym             Gym             @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@map("equipment")
}

enum UserRole {
  MEMBER
  TRAINER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PAUSED
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum DurationType {
  DAYS
  MONTHS
  YEARS
}

enum ClassCategory {
  HIIT
  YOGA
  STRENGTH
  CARDIO
  SPIN
  CROSSFIT
  PILATES
  BOXING
  DANCE
  OTHER
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum SessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum NotificationType {
  MEMBERSHIP
  BOOKING
  PAYMENT
  GENERAL
  PROMO
}

enum InquiryStatus {
  NEW
  CONTACTED
  RESOLVED
  CLOSED
}

enum AnnouncementType {
  INFO
  WARNING
  PROMO
  EVENT
  MAINTENANCE
}

enum EquipmentStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  OUT_OF_ORDER
  RETIRED
}
