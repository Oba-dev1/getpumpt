# ===========================================
# GymFlow Pro - Environment Variables
# ===========================================

# Database (PostgreSQL - Neon/Supabase)
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Auth.js / NextAuth
AUTH_SECRET=""                          # Generate with: openssl rand -base64 32
AUTH_URL="http://localhost:3000"        # Your app URL

# OAuth Providers (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Paystack Payments (to be integrated)
PAYSTACK_SECRET_KEY="sk_test_..."
PAYSTACK_PUBLIC_KEY="pk_test_..."

# Email (Resend)
RESEND_API_KEY="re_..."
EMAIL_FROM="GymFlow Pro <noreply@gymflowpro.com>"

# App URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_MARKETING_URL="https://gymflowpro.com"

# Redis (Upstash) - For background jobs
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# File Storage (Cloudflare R2)
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_ENDPOINT=""
R2_PUBLIC_URL=""

# Monitoring (Sentry)
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# SMS (Twilio) - Optional
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Feature Flags
ENABLE_GOOGLE_AUTH="false"
ENABLE_SMS_NOTIFICATIONS="false"
