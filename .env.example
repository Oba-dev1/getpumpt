# ===========================================
# GymFlow Pro - Environment Variables
# ===========================================

# Database (PostgreSQL - Supabase)
# Use the Transaction Pooler URL (port 6543) for serverless/Vercel deployments.
# Required params: pgbouncer=true&connection_limit=1
# Find this in: Supabase Dashboard > Project Settings > Database > Connection String > Transaction pooler
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Use the direct connection URL only for migrations (prisma migrate dev/deploy)
# Find this in: Supabase Dashboard > Project Settings > Database > Connection String > Direct connection
DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# Auth.js / NextAuth
AUTH_SECRET=""                          # Generate with: openssl rand -base64 32
AUTH_URL="http://localhost:3000"        # Your app URL
CRON_SECRET=""                          # Required for authenticated cron endpoints

# OAuth Providers (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Paystack Payments (to be integrated)
PAYSTACK_SECRET_KEY="sk_test_..."
PAYSTACK_PUBLIC_KEY="pk_test_..."

# Email (Resend)
RESEND_API_KEY="re_..."
EMAIL_FROM="Pumpt <noreply@getpumpt.com>"

# App URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_ROOT_DOMAIN="getpumpt.com"            # Root domain for subdomain routing
NEXT_PUBLIC_MARKETING_URL="https://getpumpt.com"

# Vercel API (Custom Domain Management)
VERCEL_API_TOKEN=""                              # Vercel personal access token
VERCEL_PROJECT_ID=""                             # Vercel project ID (from project settings)

# Redis (Upstash) - For background jobs
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# File Storage (Cloudflare R2)
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_ENDPOINT=""
R2_PUBLIC_URL=""

# Monitoring (Sentry)
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# SMS (Twilio) - Optional
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Feature Flags
ENABLE_GOOGLE_AUTH="false"
ENABLE_SMS_NOTIFICATIONS="false"
