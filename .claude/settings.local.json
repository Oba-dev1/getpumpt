{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(openssl:*)",
      "Bash(curl:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(if [ -f .env ])",
      "Bash(then echo \".env file exists\")",
      "Bash(else echo \".env file not found\")",
      "Bash(fi)",
      "Bash(if grep -q \"DATABASE_URL.*supabase\" .env)",
      "Bash(then echo \"Supabase URLs detected\")",
      "Bash(else echo \"No Supabase URLs found\")",
      "Bash(timeout 5 bash -c \"cat < /dev/null > /dev/tcp/db.zhzcfkdouukljvhhxvco.supabase.co/5432\")",
      "Bash(ping:*)",
      "Bash(wc:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "tool == \"Edit\" && tool_input.file_path matches \"\\\\.(ts|tsx)$\"",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const fs=require('fs');const f=process.env.file_path||'';if(f&&fs.existsSync(f)){const c=fs.readFileSync(f,'utf8');const m=c.match(/console\\.log/g);if(m)console.error('[Hook] WARNING: '+m.length+' console.log found in '+f+' - remove before commit')}\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const{execSync}=require('child_process');try{const files=execSync('git diff --name-only HEAD',{encoding:'utf8'}).split('\\n').filter(f=>f.match(/\\.(ts|tsx|js|jsx)$/));const fs=require('fs');let found=false;files.forEach(f=>{if(fs.existsSync(f)){const c=fs.readFileSync(f,'utf8');if(c.includes('console.log')){console.error('[Hook] WARNING: console.log in '+f);found=true}}});if(found)console.error('[Hook] Remove console.log before committing')}catch(e){}\""
          }
        ]
      }
    ]
  },
  "agents": {
    "planner": ".claude/agents/planner.md",
    "architect": ".claude/agents/architect.md",
    "code-reviewer": ".claude/agents/code-reviewer.md",
    "security-reviewer": ".claude/agents/security-reviewer.md",
    "tdd-guide": ".claude/agents/tdd-guide.md",
    "build-error-resolver": ".claude/agents/build-error-resolver.md",
    "e2e-runner": ".claude/agents/e2e-runner.md",
    "refactor-cleaner": ".claude/agents/refactor-cleaner.md",
    "doc-updater": ".claude/agents/doc-updater.md"
  },
  "commands": {
    "tdd": ".claude/commands/tdd.md",
    "plan": ".claude/commands/plan.md",
    "code-review": ".claude/commands/code-review.md",
    "build-fix": ".claude/commands/build-fix.md",
    "e2e": ".claude/commands/e2e.md",
    "refactor-clean": ".claude/commands/refactor-clean.md",
    "update-docs": ".claude/commands/update-docs.md",
    "test-coverage": ".claude/commands/test-coverage.md",
    "verify": ".claude/commands/verify.md",
    "learn": ".claude/commands/learn.md"
  }
}
